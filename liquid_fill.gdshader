shader_type canvas_item;

// Переменная, которую мы будем менять из кода (от 0.0 до 1.0)
uniform float fill_amount : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	// Получаем цвет пикселя из нашей текстуры
	vec4 tex_color = texture(TEXTURE, UV);

	// ЛОГИКА "ЖИДКОСТИ":
	// В Godot UV.y = 0 это верх, UV.y = 1 это низ.
	// Мы хотим скрыть пиксели, которые ВЫШЕ уровня заполнения.
	// Если fill_amount = 0.5 (половина), граница на 0.5.
	// Всё что имеет Y меньше 0.5 — делаем прозрачным.
	
	if (UV.y < (1.0 - fill_amount)) {
		tex_color.a = 0.0; // Скрываем пиксель (делаем прозрачным)
	}

	// Отдаем итоговый цвет движку
	COLOR = tex_color;
}